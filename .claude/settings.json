{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./sassio-saas-software-app-nextjs-template-2024-06-11-00-49-16-utc.zip)",
      "Edit(./public/css/**)",
      "Edit(./package-lock.json)",
      "Edit(./next-env.d.ts)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d node_modules ] || npm install --no-audit --no-fund"
          }
        ]
      }
    ]
  }
}
